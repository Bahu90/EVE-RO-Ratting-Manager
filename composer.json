{
  "name": "bahu90/ratting-manager",
  "description": "Ratting management plugin for SeAT - Track bounty ticks and ESS payouts for every member, with personal and corporation dashboards, leaderboards and ISK per hour",
  "type": "seat-plugin",
  "keywords": [
    "seat",
    "eve",
    "eveonline",
    "ratting",
    "bounty",
    "ess",
    "corporation",
    "management",
    "plugin"
  ],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Bahu90",
      "homepage": "https://github.com/Bahu90",
      "role": "Maintainer"
    },
    {
      "name": "Matt Falahe",
      "email": "mattfalahe@gmail.com",
      "role": "Original author"
    }
  ],
  "homepage": "https://github.com/Bahu90/EVE-RO-Ratting-Manager",
  "support": {
    "issues": "https://github.com/Bahu90/EVE-RO-Ratting-Manager/issues",
    "source": "https://github.com/Bahu90/EVE-RO-Ratting-Manager"
  },
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "eveseat/web": "^5.0",
    "eveseat/services": "^5.0"
  },
  "conflict": {
    "mattfalahe/ratting-manager": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "RattingManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RattingManager\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RattingManager\\RattingManagerServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
